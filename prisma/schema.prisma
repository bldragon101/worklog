generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GstMode {
  exclusive
  inclusive
}

enum GstStatus {
  not_registered
  registered
}

enum RctiStatus {
  draft
  finalised
  paid
}

enum JobsReportStatus {
  draft
  finalised
}

enum CustomerInvoiceStatus {
  draft
}

/// The rate class a Xero sales item is for, taken from its code prefix
enum XeroTruckClass {
  tray
  crane
  semi
  semiCrane
}

enum DeductionStatus {
  active
  completed
  cancelled
}

model Jobs {
  id                       Int              @id @default(autoincrement())
  date                     DateTime
  driver                   String
  customer                 String
  truckType                String
  comments                 String?
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  billTo                   String
  chargedHours             Float?
  travelTimeHours          Float?
  driverCharge             Float?
  deductionHours           Float?
  hideDeduction            Boolean          @default(false)
  driverOnly               Boolean?         @default(false) // Paid to the driver, not charged to the customer
  dropoff                  String?
  invoiced                 Boolean?
  pickup                   String
  registration             String
  runsheet                 Boolean?
  finishTime               DateTime?
  startTime                DateTime?
  attachmentDeliveryPhotos String[]         @default([])
  attachmentDocket         String[]         @default([])
  attachmentRunsheet       String[]         @default([])
  citylink                 Int?
  eastlink                 Int?
  jobReference             String?
  countryRunValue          Float?
  countryRunUnit           String?
  customerInvoiceId        Int?
  customerInvoice          CustomerInvoice? @relation(fields: [customerInvoiceId], references: [id], onDelete: SetNull)

  @@index([jobReference])
  @@index([customerInvoiceId])
  @@index([eastlink, citylink])
}

model Customer {
  id                          Int               @id @default(autoincrement())
  customer                    String
  billTo                      String
  contact                     String
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt
  comments                    String?
  fuelLevy                    Float?
  tray                        Int?
  crane                       Int?
  semi                        Int?
  semiCrane                   Int?
  tolls                       Boolean           @default(false)
  breakDeduction              Float?
  /// One invoice per job reference per week instead of one per week
  separateInvoicesByReference Boolean           @default(false)
  invoices                    CustomerInvoice[]
}

/// A customer invoice saved from the automatic weekly draft, either by
/// splitting jobs out of it or by selecting jobs by hand. Lines are built from
/// the jobs on read.
model CustomerInvoice {
  id                    Int                   @id @default(autoincrement())
  customerId            Int
  weekEnding            DateTime
  jobReference          String?
  reference             String
  notes                 String?
  status                CustomerInvoiceStatus @default(draft)
  waivedBreakDeductions String[]              @default([])
  createdBy             String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  customer              Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs                  Jobs[]

  @@index([customerId, weekEnding])
  @@index([weekEnding])
  @@index([status])
}

model Vehicle {
  id                Int      @id @default(autoincrement())
  registration      String   @unique
  expiryDate        DateTime
  make              String
  model             String
  yearOfManufacture Int
  type              String
  carryingCapacity  String?
  trayLength        String?
  craneReach        String?
  craneType         String?
  craneCapacity     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Driver {
  id                Int             @id @default(autoincrement())
  driver            String          @unique
  lastName          String?
  truck             String
  tray              Decimal?        @db.Decimal(10, 2)
  crane             Decimal?        @db.Decimal(10, 2)
  semi              Decimal?        @db.Decimal(10, 2)
  semiCrane         Decimal?        @db.Decimal(10, 2)
  breaks            Float?
  type              String          @default("Employee")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  fuelLevy          Float?
  tolls             Boolean         @default(false)
  email             String?
  businessName      String?
  abn               String?
  address           String?
  bankAccountName   String?
  bankAccountNumber String?
  bankBsb           String?
  gstMode           GstMode         @default(exclusive)
  gstStatus         GstStatus       @default(not_registered)
  isArchived        Boolean         @default(false)
  rctis             Rcti[]
  deductions        RctiDeduction[]
  jobsReports       JobsReport[]

  @@index([isArchived])
}

model User {
  id        String    @id
  email     String    @unique
  firstName String?
  lastName  String?
  imageUrl  String?
  role      String    @default("user")
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([email])
  @@index([role])
  @@index([isActive])
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  userId      String
  userEmail   String?
  action      String
  tableName   String
  recordId    String
  oldData     Json?
  newData     Json?
  description String
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tableName])
  @@index([createdAt])
}

model GoogleDriveSettings {
  id           Int      @id @default(autoincrement())
  userId       String
  driveId      String
  driveName    String
  baseFolderId String
  folderName   String
  folderPath   String[]
  purpose      String   @default("job_attachments")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  isGlobal     Boolean  @default(false)

  @@index([userId, purpose, isActive])
  @@index([isGlobal, purpose, isActive])
}

model GoogleDriveToken {
  id                    Int      @id @default(autoincrement())
  userId                String
  email                 String
  accessTokenEncrypted  String
  refreshTokenEncrypted String
  accessTokenIv         String
  refreshTokenIv        String
  accessTokenTag        String
  refreshTokenTag       String
  tokenExpiry           DateTime
  scopes                String[]
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([userId, isActive])
  @@index([isActive])
}

model Rcti {
  id                    Int                        @id @default(autoincrement())
  driverId              Int
  driverName            String
  businessName          String?
  driverAddress         String?
  driverAbn             String?
  gstStatus             GstStatus
  gstMode               GstMode
  bankAccountName       String?
  bankBsb               String?
  bankAccountNumber     String?
  weekEnding            DateTime
  invoiceNumber         String                     @unique
  subtotal              Decimal                    @db.Decimal(12, 2)
  gst                   Decimal                    @db.Decimal(12, 2)
  total                 Decimal                    @db.Decimal(12, 2)
  status                RctiStatus                 @default(draft)
  notes                 String?
  paidAt                DateTime?
  sentAt                DateTime?
  revertedToDraftAt     DateTime?
  revertedToDraftReason String?
  waivedBreakDeductions String[]                   @default([])
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  driver                Driver                     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  deductionApplications RctiDeductionApplication[]
  lines                 RctiLine[]
  statusChanges         RctiStatusChange[]

  @@index([driverId])
  @@index([weekEnding])
  @@index([status])
}

model RctiLine {
  id              Int      @id @default(autoincrement())
  rctiId          Int
  jobId           Int? // Optional: null for manual entries
  jobDate         DateTime
  customer        String
  truckType       String
  description     String?
  chargedHours    Decimal  @db.Decimal(12, 2)
  travelTimeHours Decimal? @db.Decimal(12, 2)

  driverCharge Decimal? @db.Decimal(12, 2)
  ratePerHour  Decimal  @db.Decimal(12, 2)
  amountExGst  Decimal  @db.Decimal(12, 2)
  gstAmount    Decimal  @db.Decimal(12, 2)
  amountIncGst Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  rcti         Rcti     @relation(fields: [rctiId], references: [id], onDelete: Cascade)

  @@index([rctiId])
  @@index([jobId])
}

model RctiDeduction {
  id              Int                        @id @default(autoincrement())
  driverId        Int
  type            String
  description     String
  totalAmount     Decimal                    @db.Decimal(12, 2)
  amountPaid      Decimal                    @default(0) @db.Decimal(12, 2)
  amountRemaining Decimal                    @db.Decimal(12, 2)
  frequency       String
  amountPerCycle  Decimal?                   @db.Decimal(12, 2)
  status          DeductionStatus            @default(active)
  startDate       DateTime
  completedAt     DateTime?
  notes           String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  driver          Driver                     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  applications    RctiDeductionApplication[]

  @@index([driverId])
  @@index([status])
  @@index([startDate])
}

model RctiDeductionApplication {
  id          Int           @id @default(autoincrement())
  deductionId Int
  rctiId      Int
  amount      Decimal       @db.Decimal(12, 2)
  appliedAt   DateTime      @default(now())
  notes       String?
  deduction   RctiDeduction @relation(fields: [deductionId], references: [id], onDelete: Cascade)
  rcti        Rcti          @relation(fields: [rctiId], references: [id], onDelete: Cascade)

  @@unique([deductionId, rctiId])
  @@index([deductionId])
  @@index([rctiId])
}

model CompanySettings {
  id               Int      @id @default(autoincrement())
  companyName      String
  companyAbn       String?
  companyAddress   String?
  companyPhone     String?
  companyEmail     String?
  companyLogo      String?
  emailReplyTo     String?
  signUpEnabled    Boolean  @default(true)
  quickEditMinRole String   @default("admin")
  defaultFuelLevy  Float?
  tollEastlinkRate Decimal  @default(18.50) @db.Decimal(10, 2)
  tollCitylinkRate Decimal  @default(31.00) @db.Decimal(10, 2)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("CompanySettings")
}

model JobsReport {
  id           Int              @id @default(autoincrement())
  driverId     Int
  driverName   String
  weekEnding   DateTime
  reportNumber String           @unique
  status       JobsReportStatus @default(draft)
  notes        String?
  sentAt       DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  driver       Driver           @relation(fields: [driverId], references: [id], onDelete: Cascade)
  lines        JobsReportLine[]

  @@unique([driverId, weekEnding])
  @@index([driverId])
  @@index([weekEnding])
  @@index([status])
}

model JobsReportLine {
  id              Int      @id @default(autoincrement())
  reportId        Int
  jobId           Int?
  jobDate         DateTime
  customer        String
  truckType       String
  startTime       String?
  finishTime      String?
  chargedHours    Decimal? @db.Decimal(12, 2)
  travelTimeHours Decimal? @db.Decimal(12, 2)

  driverCharge Decimal?   @db.Decimal(12, 2)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  report       JobsReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([jobId])
}

model RctiStatusChange {
  id         Int      @id @default(autoincrement())
  rctiId     Int
  fromStatus String
  toStatus   String
  reason     String?
  changedBy  String?
  changedAt  DateTime @default(now())
  rcti       Rcti     @relation(fields: [rctiId], references: [id], onDelete: Cascade)

  @@index([rctiId])
  @@index([changedAt])
}

model TollTrip {
  id           Int         @id @default(autoincrement())
  fingerprint  String      @unique
  tripStart    DateTime
  tripEnd      DateTime?
  tripDetails  String
  lpn          String?
  tagNumber    String?
  registration String?
  vehicleClass String?
  amount       Decimal     @db.Decimal(12, 2)
  importId     Int?
  createdAt    DateTime    @default(now())
  import       TollImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([tripStart])
  @@index([registration, tripStart])
  @@index([tagNumber])
}

model TollTag {
  tagNumber    String   @id
  registration String
  source       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TollImport {
  id          Int        @id @default(autoincrement())
  source      String
  fileName    String?
  periodFrom  DateTime?
  periodTo    DateTime?
  totalRows   Int
  inserted    Int
  duplicates  Int
  createdBy   String?
  driveFileId String?    @unique
  createdAt   DateTime   @default(now())
  trips       TollTrip[]

  @@index([createdAt])
}

model TollDriveCheck {
  id        Int      @id @default(1)
  checkedAt DateTime
}

/// The connected Xero organisation and its OAuth tokens, encrypted with
/// XERO_ENCRYPTION_KEY. Only one row is active at a time.
model XeroConnection {
  id                    Int       @id @default(autoincrement())
  tenantId              String
  tenantName            String
  /// Xero's id for the app's connection to the organisation, used to disconnect
  connectionId          String?
  userId                String
  accessTokenEncrypted  String
  accessTokenIv         String
  accessTokenTag        String
  refreshTokenEncrypted String
  refreshTokenIv        String
  refreshTokenTag       String
  tokenExpiry           DateTime
  scopes                String[]
  isActive              Boolean   @default(true)
  itemsSyncedAt         DateTime?
  contactsSyncedAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([isActive])
}

/// Sales items copied from Xero by the sync, for the mapping dropdowns
model XeroItem {
  id               Int      @id @default(autoincrement())
  itemId           String   @unique
  code             String   @unique
  name             String
  salesUnitPrice   Decimal? @db.Decimal(12, 4)
  salesAccountCode String?
  salesTaxType     String?
  isSold           Boolean  @default(true)
  syncedAt         DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

/// Contacts copied from Xero by the sync, for the bill to mapping dropdown
model XeroContact {
  id         Int      @id @default(autoincrement())
  contactId  String   @unique
  name       String
  email      String?
  isCustomer Boolean  @default(false)
  syncedAt   DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([name])
}

/// A company truck's Xero item, by normalised registration. Used for jobs
/// driven by employees.
model XeroVehicleItemMapping {
  id           Int      @id @default(autoincrement())
  /// Upper case with spaces and punctuation removed
  registration String   @unique
  itemCode     String
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// A contractor or subcontractor company's Xero item for a truck class. The
/// company is the driver's business name, or the driver's name without one.
model XeroCompanyItemMapping {
  id          Int            @id @default(autoincrement())
  /// Lower case, trimmed, single-spaced company name
  companyKey  String
  companyName String
  truckClass  XeroTruckClass
  itemCode    String
  updatedBy   String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([companyKey, truckClass])
}

/// The Xero contact an invoice is addressed to, by the customer's bill to name
model XeroContactMapping {
  id          Int      @id @default(autoincrement())
  /// Lower case, trimmed, single-spaced bill to name
  billToKey   String   @unique
  billTo      String
  contactId   String
  contactName String
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Account, tax and item codes for invoices sent to Xero. A single row.
model XeroSettings {
  id               Int      @id @default(autoincrement())
  salesAccountCode String   @default("200")
  taxType          String   @default("OUTPUT")
  breakItemCode    String?  @default("Break")
  eastlinkItemCode String?  @default("EL")
  citylinkItemCode String?  @default("CL")
  /// Used when there is no "Fuel Levy N%" item for the customer's percentage
  fuelLevyItemCode String?  @default("Fuel Levy")
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
