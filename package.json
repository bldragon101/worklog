    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "prisma": "8.1.0-dev.6",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
