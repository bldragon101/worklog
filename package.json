{
  "name": "worklog",
  "version": "1.12.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev --turbopack",
    "prebuild": "node scripts/generate-changelog.js",
    "build": "cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start",
    "lint": "eslint .",
    "postinstall": "prisma generate && node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "generate:changelog": "node scripts/generate-changelog.js",
    "db:seed": "node prisma/seed.js",
    "test": "vitest run --silent",
    "test:verbose": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --silent",
    "test:integration": "vitest run tests/integration --pool=threads --poolOptions.threads.singleThread --silent",
    "test:integration:watch": "vitest tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:golden": "pnpm exec tsx scripts/verify-golden-data.ts",
    "test:e2e": "playwright test",
    "test:e2e:docker": "playwright test --project docker",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed --project chromium",
    "db:golden:seed": "pnpm exec tsx scripts/seed-golden-data.ts seed",
    "db:golden:reset": "pnpm exec tsx scripts/seed-golden-data.ts reset",
    "db:golden:cleanup": "pnpm exec tsx scripts/seed-golden-data.ts cleanup",
    "db:golden:status": "pnpm exec tsx scripts/seed-golden-data.ts status",
    "db:golden:verify": "pnpm exec tsx scripts/verify-golden-data.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.9",
    "@hookform/resolvers": "^5.9.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-table": "9.2.4",
    "@vercel/blob": "^2.8.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "googleapis": "^182.0.0",
    "lucide-react": "^1.49.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "6.3.289",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-day-picker": "9.14.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-pdf": "^11.0.0",
    "resend": "^6.31.0",
    "svix": "2.6.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@estruyf/github-actions-reporter": "^1.12.0",
    "@peculiar/webcrypto": "^1.7.1",
    "@playwright/test": "^1.63.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.5",
    "eslint": "9.39.5",
    "eslint-config-next": "^16.3.8",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "prisma": "8.1.0-dev.7",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "glob": "^10.0.0",
    "node-domexception": "^2.0.2"
  }
}
