    "@testing-library/user-event": "^14.6.10",
    "@types/node": "^26.6.6",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "eslint": "10.14.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^31.0.0",
    "playwright": "^1.65.0",
    "prisma": "8.1.0-dev.7",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "glob": "^10.0.0",
    "node-domexception": "^2.0.2"
  }
}
