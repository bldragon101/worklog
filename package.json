{
  "name": "worklog",
  "version": "1.10.0-pre.1",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev --turbopack",
    "prebuild": "node scripts/generate-changelog.js",
    "build": "cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start",
    "lint": "eslint .",
    "postinstall": "prisma generate && node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "generate:changelog": "node scripts/generate-changelog.js",
    "db:seed": "node prisma/seed.js",
    "test": "vitest run --silent",
    "test:verbose": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --silent",
    "test:integration": "vitest run tests/integration --pool=threads --poolOptions.threads.singleThread --silent",
    "test:integration:watch": "vitest tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:golden": "pnpm exec tsx scripts/verify-golden-data.ts",
    "test:e2e": "playwright test",
    "test:e2e:docker": "playwright test --project docker",
    "test:docker-setup": "node test-docker-setup.js",
    "test:e2e:raw": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed --project chromium",
    "db:golden:seed": "pnpm exec tsx scripts/seed-golden-data.ts seed",
    "db:golden:reset": "pnpm exec tsx scripts/seed-golden-data.ts reset",
    "db:golden:cleanup": "pnpm exec tsx scripts/seed-golden-data.ts cleanup",
    "db:golden:status": "pnpm exec tsx scripts/seed-golden-data.ts status",
    "db:golden:verify": "pnpm exec tsx scripts/verify-golden-data.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "6.39.6",
