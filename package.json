{
  "name": "worklog",
  "version": "1.14.0-pre.3",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_ENV=development next dev --turbopack",
    "prebuild": "node scripts/generate-changelog.js",
    "build": "cross-env NODE_ENV=production next build",
    "start": "cross-env NODE_ENV=production next start",
    "lint": "eslint .",
    "postinstall": "prisma generate && node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "generate:changelog": "node scripts/generate-changelog.js",
    "db:seed": "node prisma/seed.js",
    "test": "vitest run --silent",
    "test:verbose": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --silent",
    "test:integration": "vitest run tests/integration --pool=threads --poolOptions.threads.singleThread --silent",
    "test:integration:watch": "vitest tests/integration",
    "test:unit": "vitest run tests/unit",
    "test:golden": "pnpm exec tsx scripts/verify-golden-data.ts",
    "test:e2e": "playwright test",
    "test:e2e:docker": "playwright test --project docker",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed --project chromium",
    "db:golden:seed": "pnpm exec tsx scripts/seed-golden-data.ts seed",
    "db:golden:reset": "pnpm exec tsx scripts/seed-golden-data.ts reset",
    "db:golden:cleanup": "pnpm exec tsx scripts/seed-golden-data.ts cleanup",
    "db:golden:status": "pnpm exec tsx scripts/seed-golden-data.ts status",
    "db:golden:verify": "pnpm exec tsx scripts/verify-golden-data.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.9.26",
    "@hookform/resolvers": "^7.0.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-table": "9.3.1",
    "@vercel/blob": "^2.9.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "googleapis": "^190.0.0",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "papaparse": "^5.7.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.5.438",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "react-pdf": "^11.0.0",
    "resend": "^6.38.0",
    "svix": "2.10.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@estruyf/github-actions-reporter": "^1.14.0",
    "@peculiar/webcrypto": "^2.0.0",
    "@playwright/test": "^1.65.0",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tanstack/react-query-devtools": "^5.107.1",
